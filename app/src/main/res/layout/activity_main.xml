<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tempo de Tela — Área dos pais"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Permitir exibir sobre outros apps (OBRIGATÓRIO)" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Permitir uso em segundo plano (bateria)" />

        <Button
            android:id="@+id/btnNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3. Permitir notificações" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="4. Iniciar controle de tempo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Regras"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUsageMin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minutos de uso até bloquear"
            android:inputType="number" />

        <EditText
            android:id="@+id/etBreakMin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minutos de pausa"
            android:inputType="number" />

        <EditText
            android:id="@+id/etRequired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Acertos necessários para liberar"
            android:inputType="number" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Salvar regras" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ferramentas"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Gerar atividades com IA (Groq) agora" />

        <Button
            android:id="@+id/btnTestLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Testar bloqueio agora" />

        <Button
            android:id="@+id/btnUnlockNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Liberar celular agora e zerar contador" />
    </LinearLayout>
</ScrollView>
